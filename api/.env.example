# Copia este archivo a .env y llena los valores. NUNCA subas .env a GitHub ni lo pegues en un chat.

# Supabase: Project Settings > API Keys
SUPABASE_URL=https://boppdniulsvoyevhoerp.supabase.co
# Clave secreta (secret / service_role). Solo vive en el servidor.
SUPABASE_SERVICE_KEY=pon-aqui-la-clave-secreta-de-supabase

# Claude: console.anthropic.com > API Keys > Create Key (elige el espacio de trabajo "Default").
# Copia la clave completa que aparece al crearla (unos 100 caracteres), sin comillas.
ANTHROPIC_API_KEY=pon-aqui-tu-clave-de-claude
IA_MODELO=claude-haiku-5-5
# Solo si tu clave es de ámbito "Organización": el ID del espacio de trabajo (empieza con wrkspc_).
# ANTHROPIC_WORKSPACE_ID=
# "bajo" (recomendado) o "sin": sin razonar es casi el doble de rápido pero acierta menos (ver CAMBIOS.md).
# IA_RAZONAMIENTO=bajo

# Reglas de la app. Los límites diarios (10 por persona, 3 por invitado, tope global) viven en la tabla
# "ajustes" de Supabase, no aquí. Si todavía tienes LIMITE_DIARIO en tu .env, puedes dejarlo: ya no se usa.
CONFIANZA_MINIMA=0.7

# Orígenes permitidos (la app en el teléfono y en desarrollo), separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,http://localhost,ionic://localhost

# Solo en el servidor de producción: oculta los detalles técnicos de los errores a las personas
# (siguen en la terminal de la API). Y deja vacío CORS_ORIGIN_REGEX para no aceptar la red local.
# PRODUCCION=1
# CORS_ORIGIN_REGEX=
