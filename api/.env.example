# Copia este archivo a .env y llena los valores. NUNCA subas .env a GitHub.

# Supabase: Project Settings > API Keys
SUPABASE_URL=https://boppdniulsvoyevhoerp.supabase.co
# Clave secreta (secret / service_role). Solo vive en el servidor.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxx

# Google Gemini (gratis, sin tarjeta): https://aistudio.google.com/apikey > Create API key
GEMINI_API_KEY=AIzaxxxxxxxxxxxx
# Modelo principal. Si no existe, se acabó su cuota, falla o tarda, la API prueba sola los de respaldo.
IA_MODELO=gemini-3.8-flash
IA_MODELOS_RESPALDO=gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash
# Segundos de espera por modelo y en total (la app espera hasta 150 s)
IA_TIEMPO_MAXIMO=40
IA_TIEMPO_TOTAL=110

# Reglas de la app
LIMITE_DIARIO=10
CONFIANZA_MINIMA=0.7

# Orígenes permitidos (la app en el teléfono y en desarrollo), separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,http://localhost,ionic://localhost
